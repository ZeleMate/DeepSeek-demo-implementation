{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Bash(cargo publish *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh release create *)",
      "Bash(gh release upload *)",
      "Bash(gh secret *)",
      "Bash(gh api -X DELETE *)",
      "Read(~/.ssh/**)",
      "Read(~/.dsh-demo/**)",
      "Bash(security *)",
      "Bash(/usr/bin/security *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api --method=DELETE *)",
      "Bash(gh api -XDELETE *)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(LEFTHOOK=* git *)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(lefthook uninstall*)",
      "Bash(env LEFTHOOK=*)",
      "Bash(export LEFTHOOK=*)"
    ],
    "allow": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr merge *)"
    ]
  }
}
