{
  "_comment": "Written by the repo template (ADR 0005); refreshed by copier update. scripts/bootstrap-github.sh applies these settings and, with --check, reports drift from them.",
  "settings": [
    {
      "body": {
        "allow_auto_merge": true,
        "allow_merge_commit": true,
        "allow_rebase_merge": false,
        "allow_squash_merge": true,
        "delete_branch_on_merge": true,
        "has_wiki": false,
        "squash_merge_commit_message": "PR_BODY",
        "squash_merge_commit_title": "PR_TITLE"
      },
      "endpoint": "repos/{repo}",
      "method": "PATCH",
      "name": "Merge commits for PRs into main (the Protect main ruleset allows no other method, ADR 0016), auto-delete branches, auto-merge allowed, no wiki"
    },
    {
      "endpoint": "repos/{repo}",
      "expect": {
        "visibility": "public"
      },
      "name": "Visibility"
    },
    {
      "body": {
        "can_approve_pull_request_reviews": false,
        "default_workflow_permissions": "read"
      },
      "endpoint": "repos/{repo}/actions/permissions/workflow",
      "method": "PUT",
      "name": "Read-only default GITHUB_TOKEN, and Actions cannot approve pull requests"
    },
    {
      "body": {
        "enabled": true,
        "sha_pinning_required": true
      },
      "endpoint": "repos/{repo}/actions/permissions",
      "method": "PUT",
      "name": "Actions enabled and pinned to full commit SHAs"
    },
    {
      "endpoint": "repos/{repo}/actions/permissions/selected-actions",
      "expect": {
        "patterns_allowed": [
          "ZeleMate/*",
          "astral-sh/setup-uv@*",
          "dependabot/fetch-metadata@*"
        ]
      },
      "name": "A selected-actions allowlist allows what the workflows call (else ci.yml fails at startup with no logs)",
      "when": {
        "repos/{repo}/actions/permissions": {
          "allowed_actions": "selected"
        }
      }
    },
    {
      "endpoint": "repos/{repo}/vulnerability-alerts",
      "method": "PUT",
      "name": "Dependabot alerts"
    },
    {
      "endpoint": "repos/{repo}/automated-security-fixes",
      "expect": {
        "enabled": true
      },
      "method": "PUT",
      "name": "Dependabot security updates"
    },
    {
      "body": {
        "security_and_analysis": {
          "secret_scanning": {
            "status": "enabled"
          },
          "secret_scanning_push_protection": {
            "status": "enabled"
          }
        }
      },
      "endpoint": "repos/{repo}",
      "method": "PATCH",
      "name": "Secret scanning and push protection"
    },
    {
      "endpoint": "repos/{repo}/private-vulnerability-reporting",
      "expect": {
        "enabled": true
      },
      "method": "PUT",
      "name": "Private vulnerability reporting"
    },
    {
      "body": {
        "query_suite": "default",
        "state": "configured"
      },
      "endpoint": "repos/{repo}/code-scanning/default-setup",
      "method": "PATCH",
      "name": "CodeQL default setup"
    },
    {
      "body": {
        "approval_policy": "all_external_contributors"
      },
      "endpoint": "repos/{repo}/actions/permissions/fork-pr-contributor-approval",
      "method": "PUT",
      "name": "Fork pull request workflows wait for approval for every outside contributor"
    },
    {
      "body_file": ".github/rulesets/main.json",
      "endpoint": "repos/{repo}/rulesets",
      "key": {
        "name": "Protect main"
      },
      "method": "POST",
      "name": "Ruleset Protect main: PR required, merge commits only, ci-ok required, review threads resolved, no force-push or deletion"
    },
    {
      "name": "Dependabot malware alerts (Settings, Advanced Security)"
    },
    {
      "name": "Lefthook hooks installed in each clone (lefthook install)"
    }
  ]
}
