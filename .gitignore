# Secrets: never commit (ADR 0007: keys live in the Keychain, not in files)
# Keep in step with scripts/checks/forbidden-paths.sh.
.env
.env.*
.env-*
.env_*
.envrc
!.env.example
*.pem
*.key
*.p12
.credentials.yaml

# dsh state: session logs and profiles live in $DSH_HOME, outside the repo
dsh-home/
*.jsonl.zstd
session.lock
cordis.patch.yml

# Unfixed upstream bugs stay off git until disclosure (ADR 0015)
eval/embargoed/

# Prototype run output (session logs, raw requests)
prototypes/*/out/

# Local tooling
node_modules/
.venv/
.idea/
.vscode/*
!.vscode/extensions.json
CLAUDE.local.md
dist/
coverage/
*.tsbuildinfo
logs/
.DS_Store
.claude/worktrees/
.claude/settings.local.json
lefthook-local.yml

# Local research output, kept off git
reports/
research_notes/
