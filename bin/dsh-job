#!/bin/sh
# Starts dsh's job profile; the only way API keys reach a dsh process (ADR 0007).
# Usage: bin/dsh-job [app args...], e.g. bin/dsh-job "what is 17+25?" or bin/dsh-job --dump-config
# Every guard lives in bin/lib/launcher.sh; this file says only what the job profile is.
set -eu

profile=job
home=home
# Only the keys a job-profile route uses are read.
keys=OPENROUTER_API_KEY # the Decisions API key joins it in M5
models=

# shellcheck source=lib/launcher.sh
. "$(dirname "$0")/lib/launcher.sh"
launch "$@"
