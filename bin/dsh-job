#!/bin/sh
# Starts dsh's job profile; the only way API keys reach a dsh process (ADR 0007).
# Usage: bin/dsh-job [app args...], e.g. bin/dsh-job "what is 17+25?" or bin/dsh-job --dump-config
set -eu

root=${DSH_DEMO_ROOT:-$HOME/.dsh-demo}

# The script re-runs itself with an empty environment plus a fixed allowlist, so nothing exported
# in the calling shell reaches dsh: no other key, no proxy, no endpoint, no DSH_* setting.
if [ "${DSH_JOB_CLEAN_ENV:-}" != 1 ]; then
  exec env -i \
    HOME="$HOME" USER="${USER:-}" PATH="$PATH" LANG="${LANG:-en_US.UTF-8}" \
    TERM="${TERM:-dumb}" TMPDIR="${TMPDIR:-/tmp}" \
    DSH_DEMO_ROOT="$root" DSH_DEMO_NO_KEYS="${DSH_DEMO_NO_KEYS:-}" DSH_JOB_CLEAN_ENV=1 \
    "$0" "$@"
fi
# DSH_JOB_CLEAN_ENV can be set by hand, so the re-run also checks that only allowlisted names are
# left. PWD, OLDPWD, SHLVL and _ are the shell's own.
for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
  case $name in
    HOME | USER | PATH | LANG | TERM | TMPDIR | DSH_DEMO_ROOT | DSH_DEMO_NO_KEYS | DSH_JOB_CLEAN_ENV) ;;
    PWD | OLDPWD | SHLVL | _) ;;
    *)
      echo "dsh-job: $name is set; start dsh-job without DSH_JOB_CLEAN_ENV so it clears the environment" >&2
      exit 1
      ;;
  esac
done

repo=$(cd "$(dirname "$0")/.." && pwd)
DSH_HOME=$root/home
workspace=$root/workspace/job
# Called by path, not through `pnpm exec`, which would run dsh in the repo instead of the workspace.
dsh=$repo/node_modules/.bin/dsh

if [ ! -x "$dsh" ]; then
  echo "dsh-job: run 'pnpm install --frozen-lockfile' in $repo first" >&2
  exit 1
fi

mkdir -p "$DSH_HOME" "$workspace"

# The home patch outranks every profile, so it stays exactly [] (ADR 0007).
home_patch=$DSH_HOME/cordis.patch.yml
[ -e "$home_patch" ] || printf '[]\n' >"$home_patch"
if [ "$(cat "$home_patch")" != "[]" ]; then
  echo "dsh-job: $home_patch must be exactly [] (ADR 0007)" >&2
  exit 1
fi

# dsh falls back to these files for keys and settings. Keys live in the Keychain, so none may
# exist: one left in the workspace by an earlier run would apply to this one (ADR 0007).
for file in "$DSH_HOME/.env" "$DSH_HOME/.credentials.yaml" "$workspace/.env"; do
  if [ -e "$file" ]; then
    echo "dsh-job: $file exists; keys live in the Keychain (ADR 0007)" >&2
    exit 1
  fi
done

# The bundle turns off dsh's instruction and skill rows, but a file one run leaves here would steer
# every later run if a row came back, so none may exist (ADR 0009, ADR 0010).
for file in AGENTS.md AGENTS.local.md CLAUDE.md CLAUDE.local.md .agents .dsh; do
  if [ -e "$workspace/$file" ]; then
    echo "dsh-job: $workspace/$file exists; the job workspace holds no instructions (ADR 0009)" >&2
    exit 1
  fi
done

# dsh reads ./.env as a key fallback and ./AGENTS.md as instructions, so it never starts
# inside a repo. A scanned repo reaches a job as a tool argument (ADR 0007, ADR 0009).
cd "$workspace"
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "dsh-job: $workspace is inside a git repo; the job workspace must not be one" >&2
  exit 1
fi

# Ollama needs no key, but pi-ai's OpenAI-compatible transport requires one. The upgrade check's
# overlay names this dummy, which is not a secret (ADR 0007).
export DSH_HOME DSH_TELEMETRY_DISABLED=1 OLLAMA_DUMMY_KEY=ollama

# First run: the job profile is dsh-base, then dsh-headless, then our bundle (#53). The manifest
# is written here instead of using dsh's template flag, which deletes an existing profile (ADR 0001).
profile=$DSH_HOME/profiles/job
if [ ! -e "$profile/package.json" ]; then
  mkdir -p "$profile"
  cat >"$profile/package.json" <<'EOF'
{
  "name": "dsh-profile-job",
  "private": true,
  "dependencies": {},
  "dsh": { "profile": { "bundles": ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"] } }
}
EOF
fi

# Without our bundle the profile is plain headless: DeepSeek's API as the default model, search
# and fetch on. So a first run that wrote the manifest but failed to add the bundle is retried
# here, and the launcher refuses to start if the bundle is still missing (ADR 0003).
has_bundle() {
  node -e '
    const bundles = require(process.argv[1]).dsh?.profile?.bundles ?? []
    process.exit(bundles.includes("@zelemate/dsh-bundle-job") ? 0 : 1)
  ' "$profile/package.json" 2>/dev/null
}
has_bundle || "$dsh" plugin --profile job add "$repo/bundles/job" >/dev/null || true
if ! has_bundle; then
  echo "dsh-job: the job profile in $profile is missing bundles/job; refusing to start" >&2
  exit 1
fi

# Keys are exported here, never passed as arguments, which anyone can see in `ps`. Only the
# keys a job-profile route uses are read. A missing item leaves the variable unset, and dsh
# fails the request with MISSING_CREDENTIAL. DSH_DEMO_NO_KEYS=1 skips the Keychain entirely
# (the upgrade check runs keyless).
# shellcheck disable=SC2043 # one key until the Decisions API route arrives (M5)
for name in OPENROUTER_API_KEY; do
  unset "$name"
  [ "${DSH_DEMO_NO_KEYS:-}" = 1 ] && continue
  if value=$(/usr/bin/security find-generic-password -a "$USER" -s "dsh-demo.$name" -w 2>/dev/null); then
    export "$name=$value"
  fi
done
unset value

exec "$dsh" --profile job "$@"
