#!/bin/sh
# Starts dsh's red-team profile on local Ollama, with its own DSH_HOME and no provider keys (ADR 0007).
# Usage: bin/dsh-redteam [app args...], e.g. bin/dsh-redteam "what is 17+25?" or bin/dsh-redteam --dump-config
# Every guard lives in bin/lib/launcher.sh; this file says only what the red-team profile is.
set -eu

profile=redteam
# Its own home, so dsh's config and key lookups never see the job profile's. Its file tools can
# still read the job profile's home until the read allowlist lands (M4, ADR 0003).
home=redteam/home
# No provider keys: the red-team profile reaches local models only (ADR 0005).
keys=
# The victim is the default model, so it is required; the grader is used by Promptfoo (#57),
# so a missing base only warns.
models="victim:redteam-qwen3.5-4b-16k:required grader:redteam-granite4.2-3b-16k:optional"

# A new run directory per launch, so each attempt starts clean (ADR 0011, #110).
fresh_workspace=true

# shellcheck source=lib/launcher.sh
. "$(dirname "$0")/lib/launcher.sh"
launch "$@"
